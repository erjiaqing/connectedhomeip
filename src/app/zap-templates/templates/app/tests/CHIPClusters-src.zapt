CHIP_ERROR {{asUpperCamelCase parent.name}}ClusterTest::WriteAttribute{{asUpperCamelCase name}}(Callback::Cancelable * onSuccessCallback, Callback::Cancelable * onFailureCallback, {{chipType}} {{asLowerCamelCase name}})
{
    Callback::Callback<DefaultSuccessCallback> * successCb = Callback::Callback<DefaultSuccessCallback>::FromCancelable(onSuccessCallback);
    Callback::Callback<DefaultFailureCallback> * failureCb = Callback::Callback<DefaultFailureCallback>::FromCancelable(onFailureCallback);
    return WriteAttribute({{ asHex code 8 }}, {{asLowerCamelCase name}}, successCb->mContext, successCb->mCall, failureCb->mCall);
}

